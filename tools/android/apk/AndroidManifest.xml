  中文：ReadPico 推送 App 的清单。minSdk 26（Android 8）：BLE GATT API 与
  TRANSPORT_LE 均可用；targetSdk 34。Android 12+（API 31+）走
  BLUETOOTH_SCAN/CONNECT 运行时权限（SCAN 带 neverForLocation，不需要定位）；
  Android 8~11 走 ACCESS_FINE_LOCATION（老系统扫描必需）。
  English: manifest for the minimal push client.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.readpico.push"
    android:versionCode="11"
    android:versionName="1.5.2">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 8~11：老系统扫描需要定位权限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- gen26 M1：AI 释义要调 LLM 出网（DeepSeek 等），必须显式声明；
         蓝牙链路本身不上网，这条只服务查词。 -->
    <!-- gen26 M1: AI definitions call an LLM over the network (DeepSeek etc.),
         so INTERNET must be declared. BLE itself never touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- M1.3（v1.4.3）：息屏查词保活。前台服务（connectedDevice 类型）让后台
         网络不被 Doze/国产 ROM 挂起；Android 13+ 的通知权限被拒不影响 FGS
         运行，仅通知不可见（状态行才是可见反馈）。 -->
    <!-- M1.3: screen-off keep-alive. The connectedDevice FGS keeps background
         networking alive under Doze/ROM policy; a denied POST_NOTIFICATIONS
         never stops the FGS (the status row is the visible feedback). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:label="PicoPush 推送"
        android:icon="@drawable/icon"
        android:allowBackup="false"
        android:supportsRtl="true">
        <!-- M1.3：监听保活前台服务。started-only（不 bind），随监听起停；
             connectedDevice 类型（Android 14 要求显式类型），静默低优先级渠道。 -->
        <!-- M1.3: the listening keep-alive FGS. Started-only, lives exactly as
             long as the listening session; explicit connectedDevice type. -->
        <service
            android:name=".ListenKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- gen26.5 Step10：听书朗读保活前台服务。与监听保活同型不同生：
             两段会话（点词监听 + 听书朗读）可同时存在，互不抢占；started-only
             （不 bind），朗读起停，connectedDevice 类型，静默低优先级渠道。 -->
        <!-- gen26.5 Step10: the read-aloud keep-alive FGS. Same shape, separate
             life from the listening one - both sessions may coexist and never
             preempt each other; started-only, lives exactly as long as the
             read-aloud session, explicit connectedDevice type, silent channel. -->
        <service
            android:name=".TtsKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- gen22：桌面快捷方式「一键推流」（长按图标可见，可拖到桌面）。
                 meta-data 必须挂在这个带 MAIN+LAUNCHER 的 Activity 上才会生效。
                 gen22: launcher shortcut "一键推流". The meta-data must sit on the
                 MAIN+LAUNCHER activity for the shortcuts to register. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
